{
  "name": "tomada",
  "productName": "Tomada",
  "version": "0.1.0",
  "private": true,
  "description": "Tomada: grava tela + câmera e edita sozinho. Tudo local.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/limpo.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/limpo.mjs electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/limpo.mjs playwright test",
    "fixtures": "node scripts/fixtures.mjs",
    "test:real": "npm run build && node scripts/limpo.mjs playwright test -c playwright.real.config.ts",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "gerar:icone": "node scripts/fila-pesada.mjs node scripts/gerar-icone.mjs",
    "criar:atalhos": "node scripts/criar-atalhos.mjs",
    "medir:codec": "node scripts/limpo.mjs electron scripts/medir-codec.cjs",
    "medir:cursor": "node scripts/limpo.mjs electron scripts/cursor-viabilidade.cjs",
    "preparar:transcricao": "vitest run -c vitest.medir.config.ts tests/medir/preparar.run.ts",
    "preparar:sincronia": "vitest run -c vitest.medir.config.ts tests/medir/preparar-sincronia.run.ts",
    "medir:sincronia": "vitest run -c vitest.medir.config.ts tests/medir/sincronia.run.ts",
    "preparar:camera": "vitest run -c vitest.medir.config.ts tests/medir/preparar-camera.run.ts",
    "medir:transcricao": "vitest run -c vitest.medir.config.ts tests/medir/medir.run.ts",
    "medir:velocidade": "node scripts/fila-pesada.mjs vitest run -c vitest.medir.config.ts tests/medir/velocidade-transcricao.run.ts",
    "test:ia": "vitest run -c vitest.ia.config.ts",
    "medir:camera": "node scripts/fila-pesada.mjs node scripts/medir-camera.mjs",
    "medir:camera:fidelidade": "node scripts/fila-pesada.mjs node scripts/medir-camera-fidelidade.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "koffi": "^3.3.2",
    "mediabunny": "^1.61.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "40.9.3",
    "electron-vite": "^5.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
